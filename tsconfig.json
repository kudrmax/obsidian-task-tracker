{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "core/**/*.ts",
    "obsidian/**/*.ts",
    "obsidian/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/e2e/**/*.ts",
    "vitest.config.mts",
    "vitest.budget.config.mts"
  ]
}
