{
	"name": "obsidian-task-tracker",
	"version": "0.4.202",
	"private": true,
	"main": "main.js",
	"scripts": {
		"build": "tsc --noEmit && tsc -p tsconfig.next-pure.json && node esbuild.config.mjs production && node core/build.mjs",
		"dev": "node esbuild.config.mjs",
		"build:demo": "tsc --noEmit && node esbuild.config.mjs production demo",
		"build:e2e": "node esbuild.config.mjs production e2e",
		"e2e": "node scripts/e2e/run.mjs",
		"e2e:smoke": "node scripts/e2e/run.mjs smoke",
		"test": "vitest run && vitest run --config vitest.budget.config.mts",
		"test:apple": "swift test --package-path apple/Core",
		"release": "node scripts/release.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.3",
		"esbuild": "^0.28.2",
		"happy-dom": "^21.0.4",
		"obsidian": "^1.13.1",
		"typescript": "7.0.2",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"preact": "11.2.0"
	}
}
